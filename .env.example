# Base URL of the ACCS Django REST API (must include /api)
# "/api" sends API and media requests through the Next.js proxy (next.config.mjs → Django on :8000),
# which also works when the site is shared through a tunnel or a domain.
# Use a full URL (e.g. http://127.0.0.1:8000/api) to call Django directly from the browser.
NEXT_PUBLIC_API_URL=/api
